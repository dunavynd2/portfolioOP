# Define log directory
# Global Constants
LOG_DIR = "/home/ec2-user/AWS"
SCRIPT_LOG = os.path.join(LOG_DIR, "script.log")
PATTERN_LOG = os.path.join(LOG_DIR, "pattern.log")
TRADING_LOG = os.path.join(LOG_DIR, "trading.log")

# Create log files if they don't exist
for log_file in [SCRIPT_LOG, PATTERN_LOG, TRADING_LOG]:
    try:
        with open(log_file, 'a') as f:
            pass
        os.chmod(log_file, 0o666)
    except Exception as e:
        print(f"Error creating log file {log_file}: {e}")

def setup_logging():
    # Create logs directory if it doesn't exist
    os.makedirs(LOG_DIR, exist_ok=True)

    # Create main logger
    logger = logging.getLogger('trading_bot')
    logger.setLevel(logging.INFO)

    # Console handler for immediate feedback
    console_handler = logging.StreamHandler()
    console_handler.setFormatter(
        logging.Formatter('%(asctime)s - %(levelname)s - %(message)s')
    )
    logger.addHandler(console_handler)
    
    # Script log handler
    script_handler = RotatingFileHandler(
        SCRIPT_LOG,
        maxBytes=10*1024*1024,  # 10MB
        backupCount=5
    )
    script_handler.setFormatter(
        logging.Formatter('%(asctime)s - %(levelname)s - %(message)s')
    )
    logger.addHandler(script_handler)
    
    # Trading activity handler
    trade_handler = RotatingFileHandler(
        TRADING_LOG,
        maxBytes=10*1024*1024,
        backupCount=5
    )
    trade_handler.setFormatter(
        logging.Formatter('%(asctime)s - TRADE - %(message)s')
    )
    logger.addHandler(trade_handler)
    
    # Pattern recognition handler
    pattern_handler = RotatingFileHandler(
        PATTERN_LOG,
        maxBytes=10*1024*1024,
        backupCount=5
    )
    pattern_handler.setFormatter(
        logging.Formatter('%(asctime)s - Pattern - %(message)s')
    )
    logger.addHandler(pattern_handler)

    # Test logging
    logger.info("Logging system initialized")
    logger.info(f"Logging to directory: {LOG_DIR}")
    
    return logger

# Initialize logger
try:
    logger = setup_logging()
except Exception as e:
    print(f"Error setting up logging: {e}")
    raise

@dataclass
class MarketRegime:
    volatility: float
    correlation: float
    trend: float
    volume_profile: float
    pattern_type: str
    risk_level: float

class EfficientFrontierPatternRecognition:
    def __init__(self, lookback_period: int = 60, short_term_period: int = 1, risk_free_rate: float = 0.03):
        self.lookback_period = lookback_period
        self.short_term_period = short_term_period
        self.risk_free_rate = risk_free_rate
        logger.info(f"Pattern Recognition initialized with {lookback_period} period lookback")

    def calculate_technical_indicators(self, price_data: pd.DataFrame) -> pd.DataFrame:
        """Calculate technical indicators"""
        df = price_data.copy()
        
        # RSI
        delta = df['Close'].diff()
        gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
        rs = gain / loss
        df['RSI'] = 100 - (100 / (1 + rs))
        
        # Moving Averages
        df['SMA_20'] = df['Close'].rolling(window=20).mean()
        df['SMA_50'] = df['Close'].rolling(window=50).mean()
        df['EMA_12'] = df['Close'].ewm(span=12, adjust=False).mean()
        df['EMA_26'] = df['Close'].ewm(span=26, adjust=False).mean()
        
        # MACD
        df['MACD'] = df['EMA_12'] - df['EMA_26']
        df['MACD_Signal'] = df['MACD'].ewm(span=9, adjust=False).mean()
        
        # Bollinger Bands
        df['BB_middle'] = df['Close'].rolling(window=20).mean()
        std = df['Close'].rolling(window=20).std()
        df['BB_upper'] = df['BB_middle'] + (std * 2)
        df['BB_lower'] = df['BB_middle'] - (std * 2)
        
        logger.info("Technical indicators calculated")
        return df

    def identify_market_regime(self, price_data: pd.DataFrame) -> MarketRegime:
        """Enhanced market regime identification with technical indicators"""
        try:
            df = self.calculate_technical_indicators(price_data)
            returns = df['Close'].pct_change().dropna()
            volatility = returns.std()
            trend = self._calculate_trend(df)
            
            # Enhanced risk calculation using technicals
            rsi = df['RSI'].iloc[-1]
            macd = df['MACD'].iloc[-1]
            macd_signal = df['MACD_Signal'].iloc[-1]
            
            # Determine market conditions
            overbought = rsi > 70
            oversold = rsi < 30
            macd_bullish = macd > macd_signal
            
            # Calculate risk level
            risk_level = self._calculate_risk_level(volatility, rsi, macd)
            
            pattern_type = self._determine_pattern_type(df)
            
            logger.info(f"Market Regime - Risk: {risk_level:.2f}, Pattern: {pattern_type}")
            
            return MarketRegime(
                volatility=volatility,
                correlation=0,
                trend=trend,
                volume_profile=0,
                pattern_type=pattern_type,
                risk_level=risk_level
            )
        except Exception as e:
            logger.error(f"Error in market regime identification: {e}")
            raise
# degen gambling and trading
    def _calculate_risk_level(self, volatility: float, rsi: float, macd: float) -> float:
        """Calculate risk level based on multiple factors"""
        try:
            # Normalize indicators
            vol_score = min(volatility * 100, 1)  # Higher volatility = higher risk
            rsi_score = abs(50 - rsi) / 50  # Extreme RSI = higher risk
            macd_score = abs(macd) / 100  # Extreme MACD = higher risk
            
            # Weighted average
            risk_level = (vol_score * 0.4 + rsi_score * 0.3 + macd_score * 0.3)
            
            return min(risk_level, 1.0)  # Cap at 1.0
        except Exception as e:
            logger.error(f"Error calculating risk level: {e}")
            return 0.5  # Default to medium risk

    def _calculate_trend(self, df: pd.DataFrame) -> float:
        """Enhanced trend calculation using multiple indicators"""
        try:
            price_trend = (df['Close'].iloc[-1] - df['Close'].iloc[0]) / df['Close'].iloc[0]
            ma_trend = df['SMA_20'].iloc[-1] > df['SMA_50'].iloc[-1]
            macd_trend = df['MACD'].iloc[-1] > df['MACD_Signal'].iloc[-1]
            
            trend_score = price_trend
            if ma_trend: trend_score += 0.1
            if macd_trend: trend_score += 0.1
            
            return trend_score
        except Exception as e:
            logger.error(f"Error calculating trend: {e}")
            return 0.0
# because math does not work
    def identify_patterns(self, price_data: pd.DataFrame) -> list:
        """Enhanced pattern identification using technical indicators"""
        try:
            df = self.calculate_technical_indicators(price_data)
            patterns = []
          # because you have to be the smartest person in the world to play the stock market  
            # Technical pattern detection
            rsi = df['RSI'].iloc[-1]
            macd = df['MACD'].iloc[-1]
            macd_signal = df['MACD_Signal'].iloc[-1]
            current_price = df['Close'].iloc[-1]
            
            # RSI patterns
            if rsi > 70:
                patterns.append({
                    'type': 'technical',
                    'name': 'RSI_overbought',
                    'final_score': min(rsi/100, 0.99)
                })
            elif rsi < 30:
                patterns.append({
                    'type': 'technical',
                    'name': 'RSI_oversold',
                    'final_score': min((30-rsi)/30, 0.99)
                })
            
            # MACD patterns
            if macd > macd_signal:
                patterns.append({
                    'type': 'technical',
                    'name': 'MACD_bullish',
                    'final_score': min(abs(macd-macd_signal), 0.99)
                })
            elif macd < macd_signal:
                patterns.append({
                    'type': 'technical',
                    'name': 'MACD_bearish',
                    'final_score': min(abs(macd_signal-macd), 0.99)
                })
            # thankful for transformers
            # Bollinger Band patterns
            if current_price > df['BB_upper'].iloc[-1]:
                patterns.append({
                    'type': 'technical',
                    'name': 'BB_upper_breach',
                    'final_score': 0.8
                })
            elif current_price < df['BB_lower'].iloc[-1]:
                patterns.append({
                    'type': 'technical',
                    'name': 'BB_lower_breach',
                    'final_score': 0.8
                })
            
            logger.info(f"Identified {len(patterns)} patterns")
            return patterns
            
        except Exception as e:
            logger.error(f"Error identifying patterns: {e}")
            return []
